{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salescopilot.local/spec/v1/transcript.schema.json",
  "title": "transcript.json",
  "description": "The current transcript of one meeting, with speakers. See spec/meeting-format.md. Unknown properties must be kept when the file is rewritten.",
  "type": "object",
  "required": [
    "formatVersion",
    "meetingId",
    "generation",
    "revision",
    "status",
    "updatedAt",
    "updatedBy",
    "producedBy",
    "speakers",
    "segments"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "meetingId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "generation": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "New for every transcription run. Edits keep the generation; transcribing again creates a new one. Recorders never replace a generation the hub has accepted."
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Owned by the hub: a per-meeting transcript counter that keeps counting across generations. 0 = never accepted. Recorders send their base revision; the hub ignores it."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "final"
      ],
      "description": "draft = made on a phone; the hub replaces it with a final transcript unless the user edited the draft."
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updatedBy": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "deviceId of the last device that changed this file. The hub takes it from the caller's token."
    },
    "producedBy": {
      "type": "object",
      "required": [
        "device",
        "engine",
        "createdAt"
      ],
      "properties": {
        "device": {
          "$ref": "common.schema.json#/$defs/device"
        },
        "engine": {
          "type": "string",
          "maxLength": 64,
          "description": "Speech-to-text engine, e.g. apple-speechanalyzer, whisper, parakeet, nemotron-asr, nemotron-transcribe, soniox."
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "description": "e.g. parakeet-tdt-0.6b-v3, ggml-base, nemotron-3.5-asr-streaming-0.6b"
        },
        "diarization": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "engine"
              ],
              "properties": {
                "engine": {
                  "type": "string",
                  "maxLength": 64
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "null when speakers were not detected."
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "languageCode": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/languageCode"
        },
        {
          "type": "null"
        }
      ],
      "description": "Main language of the transcript (chosen or detected)."
    },
    "speakers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/speaker"
      },
      "description": "Empty when speakers were not detected."
    },
    "segments": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "$ref": "#/$defs/segment"
      },
      "description": "Sorted by startSec, then endSec, then id. Segments may overlap."
    }
  },
  "$defs": {
    "speaker": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId",
          "description": "Unique within the generation, e.g. S1."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "description": "Set by the user after listening; null until then."
        },
        "isLocalUser": {
          "type": "boolean",
          "description": "True for the person who recorded (on computers: the microphone side)."
        },
        "personId": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Links the same person across meetings. Voice data behind it never leaves the device that created it."
        },
        "samples": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "common.schema.json#/$defs/timeRange"
          },
          "description": "Short, clean stretches of this speaker in the audio, for 'listen and name'."
        },
        "edited": {
          "type": "boolean",
          "default": false,
          "description": "True once a user changed name, isLocalUser or personId."
        }
      }
    },
    "segment": {
      "type": "object",
      "required": [
        "id",
        "startSec",
        "endSec",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId",
          "description": "Unique within the generation and stable across edits."
        },
        "startSec": {
          "$ref": "common.schema.json#/$defs/seconds"
        },
        "endSec": {
          "$ref": "common.schema.json#/$defs/seconds"
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "speakerId": {
          "oneOf": [
            {
              "$ref": "#/$defs/localId"
            },
            {
              "type": "null"
            }
          ]
        },
        "audioSource": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "microphone",
            "system",
            null
          ],
          "description": "Which input the speech came from, when the recorder captured them separately (computers).",
          "x-extensible-enum": true
        },
        "languageCode": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/languageCode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only when it differs from the transcript language (code-switching)."
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "startSec",
              "endSec"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 500
              },
              "startSec": {
                "$ref": "common.schema.json#/$defs/seconds"
              },
              "endSec": {
                "$ref": "common.schema.json#/$defs/seconds"
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "description": "Optional word timings. Apps drop them for a segment whose text the user edited."
        },
        "edited": {
          "type": "boolean",
          "default": false,
          "description": "True once a user changed text, times or speaker."
        }
      }
    },
    "localId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  }
}
